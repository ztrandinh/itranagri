    "db:codes:check": "tsx scripts/normalize-codes.ts --check",
    "db:seed:sim": "tsx scripts/simulate.ts && tsx scripts/normalize-codes.ts",
    "db:seed:history": "tsx scripts/seed-history.ts && tsx scripts/normalize-codes.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.9",
    "jszip": "^3.10.1",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
