DATABASE_ADMIN_URL=postgres://postgres:itranagri@localhost:54499/itranagri
DATABASE_URL=postgres://app_user:app_user_pw@localhost:54499/itranagri
SESSION_SECRET=dev-secret-change-me-please-32chars!!
# Bắt buộc set (không còn fallback mặc định) — dùng cho cron gọi /api/jobs/* (x-job-key) và scheduler nội bộ.
JOB_KEY=dev-job-key-change-me
# CHỈ cần nếu deploy qua Vercel — bật Vercel Cron gọi các job đêm/dispatch thay cho setInterval trong
# instrumentation.ts (chỉ chạy đúng khi có process dài hạn, không đúng trên serverless). Set giá trị
# ngẫu nhiên mạnh ở Vercel Project Settings → Environment Variables; Vercel tự gửi header
# "Authorization: Bearer $CRON_SECRET" khi gọi các path khai trong vercel.json. Không cần nếu deploy Docker.
# CRON_SECRET=
